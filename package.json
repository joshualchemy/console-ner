{
  "name": "console-ner",
  "version": "0.1.0",
  "description": "Deterministic, extensible named entity recognition and confidence-aware validation for TypeScript",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "bun run demo/server.ts",
    "demo": "bun --hot demo/server.ts --live-reload",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external compromise",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "benchmark": "node --import tsx benchmarks/recognition.ts"
  },
  "keywords": [
    "ner",
    "named-entity-recognition",
    "tokenization",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "compromise": "14.16.0"
  }
}
